# App-specific variables (infra URLs are set by root deploy/.env in full-stack dev)
PORT=3000
NODE_ENV=development
SESSION_SECRET=dev-session-secret-change-me

# Public URLs for OAuth redirects (browser-facing, via nginx)
APP_PUBLIC_URL=http://localhost:8080/app
API_PUBLIC_URL=http://localhost:8080/api

# PostgreSQL connection. Supplied by root compose in full-stack dev (see
# ../deploy/docker-compose.dev.yml) rather than set here; only needed locally if
# you run the API outside Compose.
# DATABASE_URL=postgresql://yggdrasil:yggdrasil@localhost:5432/yggdrasil

# Session cookie `Domain` attribute. Leave unset in dev (web and api share an
# origin via nginx path routing, so the cookie's default host-only scope
# already covers both). In a subdomain deploy (APP_HOST/API_HOST on different
# hosts), set this to the shared parent domain, e.g. ".example.com" — without
# it, a cookie set by the api host is invisible to the web host, and the
# Next.js middleware's session check will bounce every request back to
# /login even after a successful GitHub sign-in.
SESSION_COOKIE_DOMAIN=

# GitHub OAuth App — identity only (read:user). Required: this is the only
# sign-in method (ADR 009); without it GET /auth/github returns 503.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App — repository access (installations, webhooks, job tokens)
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_WEBHOOK_SECRET=

# Project secrets (ADR 003 §16) — envelope encryption key for project-level
# env vars stored in Postgres. 32 bytes, base64-encoded:
#   openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Shared bearer token the Orchestrator sends when fetching decrypted project
# secrets from the internal API (the same value must be set as
# INTERNAL_API_TOKEN in orchestrator/.env).
INTERNAL_API_TOKEN=dev-internal-api-token-change-me

# Base domain for a project's always-on primary deployment
# (<project-slug>.apps.<domain>, ADR 003 §15) — used only to build the link
# shown on project home (GET /:projectId/deploy). Must match the
# Orchestrator's own APPS_BASE_DOMAIN (orchestrator/.env) exactly; the two
# are set independently, not shared at runtime.
#
# For local dev: 127.0.0.1.nip.io resolves <anything>.127.0.0.1.nip.io to
# 127.0.0.1 with no /etc/hosts editing — "yggdrasil.local" below doesn't
# resolve anywhere and the deploy link will fail to load if left as-is.
APPS_BASE_DOMAIN=127.0.0.1.nip.io

# Only for local dev: if your local cluster's ingress is published on a
# non-standard host port (there's no bundled cluster/port in deploy/.env
# anymore — you choose this when you publish your own cluster's ingress, see
# orchestrator/docs/overview/setup.md), set this to match so the deploy link
# includes it. Leave empty in prod-shaped envs (a real install's ingress/LB
# owns 443).
APPS_HTTPS_PORT=8443

# --- Background work ---
# Both are on by default. `!= "false"` means any value other than the literal
# string "false" leaves them enabled, so `0` here would *not* switch them off.
# Each has a kill switch because a background loop that has to be switched on is
# one that silently does nothing after a fresh install.

# Test-run scheduler (ADR 026) — fires a Test entity's scheduleCron. Multi-
# replica safe via a transactional SKIP LOCKED claim, so this does not need
# coordinating across API replicas. Times are interpreted in UTC.
# TEST_SCHEDULER_ENABLED=true
# TEST_SCHEDULER_INTERVAL_MS=60000

# Live job-event relay (ADR 019) — the Web app's WebSocket. An accelerator over
# the REST read the Web app already polls, so switching it off degrades to the
# previous behaviour rather than breaking anything; that property is why the
# toggle is worth having. retryDelayMs is floored at 1000 so a bad value cannot
# turn a failing Postgres connection into a tight reconnect loop.
# LIVE_RELAY_ENABLED=true
# LIVE_RELAY_RETRY_MS=5000

# Relay limits (ADR 019 follow-up 4, issue #24). Two different bounds on two
# different resources:
#
#   LIVE_FRAMES_PER_SECOND / LIVE_FRAME_BURST — a token bucket per socket, over
#   every frame the server sends it. Exceeding it *closes that socket* with the
#   application close code 4429; the client falls back to its REST poll, which is
#   a complete state path, so the cost is immediacy and never content. The
#   defaults are ~4x the busiest stream the product can produce (the
#   orchestrator coalesces deltas every 75ms, so a job emits at most ~13/s),
#   deliberately: a limit that fires during normal work is a worse bug than the
#   gap it closes. Raise them, do not remove them, if a legitimate workload is
#   ever refused.
#
#   LIVE_DELTA_BYTES_PER_JOB — total delta text relayed for one job before that
#   job's deltas stop being relayed. This bounds the *producer* (a runaway model,
#   a producer bug) rather than the consumer, so it does NOT close anyone's
#   socket and does NOT fail the job: subscribers did nothing wrong, and the
#   authoritative agent_text still arrives over the stored-event path. 0 disables
#   the ceiling, following RECORDING_MAX_BYTES' convention that 0 is a meaningful
#   "off" rather than an unset value.
#
# All three are floored so a bad value cannot close every socket on its first
# frame, which would be an outage caused by the protection.
# LIVE_FRAMES_PER_SECOND=60
# LIVE_FRAME_BURST=120
# LIVE_DELTA_BYTES_PER_JOB=8000000

# --- Screen recordings (ADR 029) ---
# Browser video for test runs. maxBytes is the important one: recordings are
# orders of magnitude larger than the JSON reports beside them and the bytes are
# stored **in Postgres** (no S3 client exists in this codebase), so an unbounded
# upload is a way to exhaust the database. A run over the cap is *skipped*, not
# failed, and the report records that it was skipped. Expiry tombstones the row
# rather than deleting it, so the UI can still say a recording existed.
# RECORDINGS_ENABLED=true
# RECORDING_MAX_BYTES=25000000
# RECORDING_RETENTION_DAYS=30
# RECORDING_SWEEP_INTERVAL_MS=900000

# --- Per-step screenshots (issue #22) ---
# The bytes behind `test_run_steps.screenshot_path`, which until now was the same
# dead pointer ADR 029 fixed for recordings: a path inside a pod that is deleted
# at job end. Stored in `job_screenshots`, tombstoned on expiry like recordings,
# and served by the API behind the session cookie rather than from a public URL.
#
# Deliberately its own values rather than shared with the recording ones, even
# though the defaults agree: screenshots are three orders of magnitude smaller
# (a few hundred kB against tens of MB), so a project may reasonably keep them
# longer than the video — and shared config would be the thing preventing that.
#
# maxBytes bounds one file; maxPerJob bounds a run. Both are needed, and the
# second is not implied by the first: how many steps a run has is decided by the
# `##` headings in the project's own test markdown, so a spec with thousands of
# headings would be thousands of files.
#
# The accepted formats are image/png, image/jpeg and image/webp, and are not
# configurable on purpose — that whitelist is a security boundary (an SVG can
# carry script and these bytes are served inline from our own origin), not a
# tuning knob. A run at its per-job quota gets a non-fatal refusal, never a
# failed test run (ADR 029 item 5).
# SCREENSHOTS_ENABLED=true
# SCREENSHOT_MAX_BYTES=2000000
# SCREENSHOT_MAX_PER_JOB=50
# SCREENSHOT_RETENTION_DAYS=30
# SCREENSHOT_SWEEP_INTERVAL_MS=900000
